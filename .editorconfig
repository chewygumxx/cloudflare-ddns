# vim:set expandtab shiftwidth=4 filetype=editorconfig:
# SPDX-License-Identifier: GPL-3.0-only

#
#
# ~chewygumxx/cloudflare-ddns.git
# ::: :/.editorconfig
#
#

root = true

# ----------
# All files
# ----------
[*]

charset = utf-8

indent_size = 4
indent_style = space
trim_trailing_whitespace = true

end_of_line = lf
insert_final_newline = true

# ---------
# Markdown
# ---------
[*.md]
indent_size = 2

# -----
# YAML
# -----
# yamlfmt indents by two.
[*.{yaml,yml}]
indent_size = 2

# ---------
# Makefile
# ---------
# make requires a recipe to be indented with a tab.
[Makefile]
indent_style = tab
