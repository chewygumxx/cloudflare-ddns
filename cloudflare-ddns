#!/usr/bin/env bash
# vim:set expandtab shiftwidth=4 filetype=bash:
# SPDX-License-Identifier: GPL-3.0-only
# shellcheck source=/dev/null

#
#
# ~chewygumxx/cloudflare-ddns.git
# ::: :/cloudflare-ddns
#
#

set -euo pipefail
: "${DEBUG:=0}"

__curl() {
    command curl \
        --silent \
        --connect-timeout 10 \
        --max-time 30 \
        --retry 3 \
        --retry-delay 2 \
        --retry-connrefused \
        --show-error \
        --fail-with-body \
        "$@"
}

__api_call() {
    if [[ "${1-}" == .* ]]; then
        local jq_filter="$1"
        shift
    fi
    __curl "https://api.cloudflare.com/client/v4/zones/${ZONE_ID}/dns_records/${RECORD_ID}" \
        -H @<(printf "%s\n" "Authorization: Bearer $API_TOKEN") \
        -H "Content-Type: application/json" \
        "$@" |
        jq --indent 4 -er "
        if   .success
        then .result${jq_filter-} // error(\"result field is null or missing\")
        else error( ([.errors[]?.message] | join(\"; \") | select(length > 0)) // \"unknown error\" )
        end
    "
}

__fail() {
    printf "[ERROR] %s\n" "$@" >&2
    exit 1
}

source "${ENVPATH:?ENVPATH is not set}"
: "${API_TOKEN:?API_TOKEN is not set}"
: "${ZONE_ID:?ZONE_ID is not set}"
: "${RECORD_NAME:?RECORD_NAME is not set}"
: "${RECORD_ID:?RECORD_ID is not set}"
: "${TTL:=300}"
: "${PROXIED:=false}"
[[ "$TTL" =~ ^[0-9]+$ ]] || __fail "TTL must be a whole number of seconds: $TTL"
[[ "$PROXIED" == true || "$PROXIED" == false ]] || __fail "PROXIED must be true or false: $PROXIED"

# --------------
# Validate Sync
# --------------

current_ip="$(__curl --ipv4 "https://cloudflare.com/cdn-cgi/trace" | awk -F= '/^ip=/{print $2}')"
[[ "$current_ip" =~ ^([0-9]{1,3}\.){3}[0-9]{1,3}$ ]] ||
    __fail "Could not resolve the public IPv4 address: '$current_ip'"
record="$(__api_call)"
record_name="$(jq -r .name <<<"$record")"
[[ "$record_name" == "$RECORD_NAME" ]] ||
    __fail "Record $RECORD_ID is $record_name, not $RECORD_NAME"

# Cloudflare stores a proxied record's TTL as 1 ("Automatic"), whatever is
# sent, so that is what a proxied record is compared against.
desired="$(jq -n \
    --arg content "$current_ip" \
    --argjson ttl "$TTL" \
    --argjson proxied "$PROXIED" \
    '{
        content: $content,
        ttl:     (if $proxied then 1 else $ttl end),
        proxied: $proxied
    }')"

changes="$(jq -r --argjson desired "$desired" '
    . as $record
    | $desired | to_entries[]
    | select($record[.key] != .value)
    | "[INFO]   \(.key): \($record[.key]) -> \(.value)"
' <<<"$record")"
if [[ -z "$changes" ]]; then
    [[ "$DEBUG" != 0 ]] && printf "%s\n" "[DEBUG] $RECORD_NAME is in sync: $current_ip"
    exit 0
fi

printf "[INFO] %s\n" "$RECORD_NAME is out of sync"
printf "%s\n" "$changes"

# -----------
# Update DNS
# -----------

content="$(jq \
    --arg comment "$(basename -- "${BASH_SOURCE[0]}")" \
    '. + {comment: $comment}' <<<"$desired" |
    __api_call .content -X PATCH --data-binary @-)"
printf "[INFO] %s\n" "Updated $RECORD_NAME: $content"
