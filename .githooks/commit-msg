# ::: :/.githooks/commit-msg
#
#

# The messages git and GitHub write, which the shared commitlint configuration
# ignores by default: a merge, a revert and an autosquash commit.
case $(head -n 1 "$1") in
"Merge "* | "Revert "* | "revert "* | "amend!"* | "fixup!"* | "squash!"*) exit 0 ;;
esac

exec mise exec -- committed --commit-file "$1"
